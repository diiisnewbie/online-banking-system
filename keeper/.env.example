# ==========================================
# TERM DEPOSIT AUTO-RENEW KEEPER BOT CONFIG
# ==========================================

# 1. RPC Endpoint
# For Hardhat Local node:
RPC_URL=http://127.0.0.1:8545

# For Sepolia Testnet (Alchemy, Infura, or Public Node):
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# 2. SavingCore Contract Address
SAVING_CORE_ADDRESS=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707

# 3. Keeper Bot Private Key (Must have ETH to pay gas)
# Default Hardhat Account #3 (0x90F79bf6EB2c4f870365E785982E1f101E93b906):
KEEPER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# 4. Polling Interval (in milliseconds)
POLL_INTERVAL_MS=3000

# 5. Gas Limit Protection (Gwei)
MAX_GAS_PRICE_GWEI=100

# 6. Optional Notification Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
